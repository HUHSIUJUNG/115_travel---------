rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    match /trips/{tripId} {
      allow read: if isSignedIn() && userEmail() in resource.data.memberEmails;

      allow create: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.memberEmails is list
        && request.resource.data.memberEmails.size() >= 2
        && userEmail() in request.resource.data.memberEmails
        && request.resource.data.currency is string;

      allow update, delete: if isSignedIn() && userEmail() in resource.data.memberEmails;

      match /expenses/{expenseId} {
        function isTripMember() {
          return isSignedIn()
            && userEmail() in get(/databases/$(database)/documents/trips/$(tripId)).data.memberEmails;
        }

        allow read: if isTripMember();

        allow create, update: if isTripMember()
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.date is string
          && request.resource.data.payer is string
          && (!('category' in request.resource.data)
            || request.resource.data.category in ['餐飲', '交通', '住宿', '購物', '門票', '其他']);

        allow delete: if isTripMember();
      }
    }
  }
}
